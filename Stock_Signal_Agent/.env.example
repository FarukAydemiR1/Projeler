# Telegram bot ayarları (örnek şablon)
#
# KULLANIM:
#   1. Bu dosyayı ".env" adıyla kopyala:   cp .env.example .env
#   2. Aşağıdaki değerleri @BotFather'dan aldığın gerçek bilgilerle doldur.
#
# GÜVENLİK: ".env" dosyası .gitignore'dadır; repoya ASLA gönderilmez.
# Token'ını buraya (.env.example) DEĞİL, kopyaladığın .env dosyasına yaz.
# Token bir şifredir — kimseyle paylaşma, ekran görüntüsünü atma.

TELEGRAM_BOT_TOKEN=123456789:BotFatherdan_aldigin_token
TELEGRAM_CHAT_ID=senin_chat_id_numaran
