# ---------------------------------------------------------------------------
# LLM (urun puanlama + reklam konsepti). Hicbiri yoksa ajan calisir ama
# deterministik/taslak rapor uretir.
#
# Hangi saglayici kullanilacak? Bos birakin = anahtari olan ilk saglayici secilir
# (once NVIDIA, sonra OpenRouter, sonra Anthropic).
# Secenekler: auto | nvidia | openrouter | anthropic | local
LLM_PROVIDER=

# NVIDIA Nemotron 3 Ultra (550B) — build.nvidia.com > "Get API Key" (nvapi-... ile baslar)
NVIDIA_API_KEY=

# Ayni modelin OpenRouter uzerinden ucretsiz ucu — openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Claude (anthropic SDK)
ANTHROPIC_API_KEY=

# Gelismis (opsiyonel): saglayici varsayilanlarini ezer
# LLM_MODEL=nvidia/nemotron-3-ultra
# LLM_BASE_URL=http://localhost:8000/v1     # self-host vLLM/SGLang ucu
# LLM_API_KEY=                              # saglayici farketmeksizin tek anahtar
# LLM_THINKING=0                            # 1 = reasoning acik (yavas + cok token)
# LLM_MAX_TOKENS=
# LLM_TEMPERATURE=
# LLM_TIMEOUT=180
# ---------------------------------------------------------------------------

# Opsiyonel: Product Hunt GraphQL API developer token (kaynak yoksa devre disi kalir)
PRODUCTHUNT_TOKEN=

# Telegram botu (bot.py + run.py --telegram)
# Token'i @BotFather'dan alin. DIKKAT: token'i kimseyle paylasmayin, sohbete yapistirmayin;
# sizdiysa @BotFather -> /revoke ile iptal edip yenisini alin. Bu dosya .gitignore'dadir.
TELEGRAM_BOT_TOKEN=
# Botun rapor gonderecegi sohbet. Botu baslatip /start yazinca chat id'niz size soylenir.
TELEGRAM_CHAT_ID=
# Botu kullanabilecek kullanici id'leri (virgulle). Bos ise sadece TELEGRAM_CHAT_ID yetkili.
TELEGRAM_ALLOWED_USERS=

# Opsiyonel: kurumsal proxy / ozel CA kullaniliyorsa
# REQUESTS_CA_BUNDLE=/path/to/ca-bundle.crt
